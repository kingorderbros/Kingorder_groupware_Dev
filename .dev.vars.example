# 로컬 실행용 환경변수 본보기 — 복사해서 .dev.vars 로 이름을 바꾸고 값을 채웁니다 (.dev.vars 는 git 에 올라가지 않습니다)
# 법인차량 API 와 로그인 계정 관리(/api/auth/* — 계정 만들기 · 비밀번호 초기화)가 이 값을 씁니다

SUPABASE_URL=https://sejoauspxqrnsrhevwkj.supabase.co

# ↓ 여기는 Supabase 의 **비밀 키**(secret / service_role)를 넣습니다. sb_secret_ 또는 eyJ 로 시작합니다.
#   config/app-config.js 에 있는 sb_publishable_ 키(공개용)를 넣으면 계정 만들기가 401 로 실패합니다.
#   Supabase 대시보드 › 해당 프로젝트 › Project Settings › API Keys 에서 Secret key 의 [Reveal] 로 확인합니다.
SUPABASE_SERVICE_ROLE_KEY=여기에_비밀키를_붙여넣기

KOB_ENV=dev
