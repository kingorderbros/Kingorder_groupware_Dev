{
  "permissions": {
    "allow": [
      "Bash(npm run check*)",
      "Bash(npm test*)",
      "Bash(npm run test*)",
      "Bash(node --check *)",
      "Bash(node --test *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(npm run deploy:prod*)",
      "Bash(*wrangler deploy --name*)",
      "Read(./.dev.vars)",
      "Read(./**/.dev.vars)"
    ]
  }
}
